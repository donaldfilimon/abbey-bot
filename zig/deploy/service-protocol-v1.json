{
  "readiness": {
    "max_bytes": 4096,
    "fields": {
      "schema_version": {
        "type": "integer",
        "min": 1,
        "max": 1
      },
      "pid": {
        "type": "integer",
        "min": 1,
        "max": 2147483647
      },
      "run_nonce": {
        "type": "hex",
        "length": 64
      },
      "executable_sha256": {
        "type": "hex",
        "length": 64
      },
      "phase": {
        "type": "enum",
        "values": [
          "starting",
          "ready",
          "draining"
        ]
      },
      "published_at_unix_ms": {
        "type": "integer",
        "min": 0,
        "max": 9223372036854775807
      },
      "discord": {
        "type": "enum",
        "values": [
          "connecting",
          "ready",
          "stopped"
        ]
      },
      "scheduler": {
        "type": "enum",
        "values": [
          "starting",
          "running",
          "stopped"
        ]
      },
      "telegram": {
        "type": "enum",
        "values": [
          "disabled",
          "starting",
          "connected",
          "degraded",
          "stopped"
        ]
      },
      "slack": {
        "type": "enum",
        "values": [
          "disabled",
          "starting",
          "connected",
          "degraded",
          "stopped"
        ]
      },
      "last_persistence": {
        "type": "enum",
        "values": [
          "not_attempted",
          "memory_only",
          "complete",
          "partial",
          "failed"
        ]
      }
    }
  },
  "bootstrap": {
    "max_bytes": 512,
    "fields": {
      "schema_version": {
        "type": "integer",
        "min": 1,
        "max": 1
      },
      "pid": {
        "type": "integer",
        "min": 1,
        "max": 2147483647
      },
      "run_nonce": {
        "type": "hex",
        "length": 64
      },
      "executable_sha256": {
        "type": "hex",
        "length": 64
      },
      "phase": {
        "type": "enum",
        "values": [
          "starting",
          "failed"
        ]
      },
      "code": {
        "type": "enum",
        "values": [
          "none",
          "readiness_file",
          "log_directory",
          "log_file",
          "log_writer"
        ]
      }
    }
  }
}
