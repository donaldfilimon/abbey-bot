# Bot token from the Discord Developer Portal. Never commit the real value.
# If it ever leaks, rotate it in the portal immediately — revoking is the fix,
# deleting the commit is not.
DISCORD_TOKEN=

# Optional. Register slash commands to this guild only: instant, which is what
# you want while iterating. Leave unset to register globally, which can take up
# to an hour to propagate.
ABBEY_GUILD_ID=

# Optional. /persona ask's generation backend — first match wins, and with
# neither set the command replies that no generation backend is configured.
#
# Anthropic Messages API (external; costs money per token). This is a secret
# with DISCORD_TOKEN's exact handling: env only, rotate on leak.
ANTHROPIC_API_KEY=

# OpenAI-compatible server, usually loopback (llama-server / ollama / mlx).
# Base URL only, e.g. http://127.0.0.1:8080 — the bot appends
# /v1/chat/completions. Plain HTTP is loopback-only; remote endpoints require
# HTTPS. Credentials, query strings, and fragments are rejected. llama-server
# and mlx ignore the model name; ollama resolves it, so name one or ollama
# returns 404 (measured default: gpt-oss:20b).
ABBEY_BOT_LLM_ENDPOINT=
ABBEY_BOT_LLM_MODEL=gpt-oss:20b
# Optional. Concurrent generations (default 1 local / 4 Anthropic) and how long a
# turn waits for a slot before answering "busy" (default 90).
ABBEY_BOT_LLM_CONCURRENCY=
# Optional. `off` stops the model from calling Abbey's tools (remember/recall/
# reputation/persona/recent messages). Default on; degrades itself on a 4xx.
ABBEY_BOT_LLM_TOOLS=
ABBEY_BOT_LLM_QUEUE_SECS=
# Optional. Seconds before a backend call is abandoned (default 300).
ABBEY_BOT_LLM_TIMEOUT_SECS=

# Optional. 1 = never speak unsolicited anywhere; mentions, DMs, and slash
# commands still answer. Keep this on while the policy is untrained on a
# token that sits in many servers.
ABBEY_QUIET=

# Optional tracing filter. Defaults to `info`.
RUST_LOG=info

# Optional. Where Abbey persists what she learns (per-guild DQN snapshots,
# reputation, memory facts, the WDBX segment). Unset = in-memory only, lost on
# restart. The directory is created if missing.
# The macOS launchd installer deliberately ignores this value and always uses
# ~/.local/share/abbey-bot/data so one fixed private directory owns its state.
ABBEY_DATA_DIR=

# Optional. Set to 1 to request the privileged MESSAGE_CONTENT intent. It must
# ALSO be enabled for the bot in the Developer Portal, or the gateway silently
# sends nothing. Without it Abbey only sees the content of messages that mention
# her or are DMs, and the adaptive loop learns from those alone.
ABBEY_MESSAGE_CONTENT=

# Optional. Image understanding for /see, /ocr, and attachment folding. Any
# OpenAI-compatible vision endpoint; remote URLs require HTTPS and loopback may
# use HTTP. Falls back to ABBEY_BOT_LLM_ENDPOINT when unset (set it to `off` to
# stop that fallback for a text-only local model).
# Blank with no LLM endpoint = vision off.
ABBEY_VISION_ENDPOINT=
ABBEY_VISION_MODEL=
ABBEY_VISION_KEY=

# Optional. Discord voice, locked to exactly one destination. BOTH IDs enable
# `/voice join`; without OPENAI_API_KEY Abbey joins self-deafened and cannot
# receive or send audio. A key enables full-duplex OpenAI Realtime, so tell
# everyone present before using that mode. The key is a secret with
# DISCORD_TOKEN's handling: env only. Setting the key alone never opts in.
ABBEY_VOICE_GUILD_ID=
ABBEY_VOICE_CHANNEL_ID=
# Operations-only, self-deafened startup connection. Refused when a provider
# key exists, so it can never begin transmitting call audio automatically.
ABBEY_VOICE_AUTOJOIN=0
OPENAI_API_KEY=
# Current official server-to-server default; override deliberately when a new
# Realtime model/voice is selected. Remote endpoints must use wss; loopback may
# use ws for a test double.
ABBEY_VOICE_REALTIME_ENDPOINT=wss://api.openai.com/v1/realtime
ABBEY_VOICE_REALTIME_MODEL=gpt-realtime-2.1
ABBEY_VOICE_NAME=marin
# Optional one-line persona/instructions override. The built-in Abbey voice
# prompt is used when blank.
ABBEY_VOICE_INSTRUCTIONS=

# Optional. Telegram Bot API token — runs the long-poll adapter alongside the
# Discord gateway, feeding the same brain/memory pipeline. Secret: env only.
TELEGRAM_BOT_TOKEN=

# Optional. Slack over Socket Mode: the xoxb- bot token for the Web API and
# the xapp- app-level token for apps.connections.open. Both required; both
# secrets, env only.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
