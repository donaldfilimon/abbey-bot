# Bot token from the Discord Developer Portal. Never commit the real value.
# If it ever leaks, rotate it in the portal immediately — revoking is the fix,
# deleting the commit is not.
DISCORD_TOKEN=

# Optional. Register slash commands to this guild only: instant, which is what
# you want while iterating. Leave unset to register globally, which can take up
# to an hour to propagate.
ABBEY_GUILD_ID=

# Optional. /persona ask's generation backend — first match wins, and with
# neither set the command replies that no generation backend is configured.
#
# Anthropic Messages API (external; costs money per token). This is a secret
# with DISCORD_TOKEN's exact handling: env only, rotate on leak.
ANTHROPIC_API_KEY=

# OpenAI-compatible server, usually loopback (llama-server / ollama / mlx).
# Base URL only, e.g. http://127.0.0.1:8080 — the bot appends
# /v1/chat/completions. The server's own --model choice is what answers.
ABBEY_BOT_LLM_ENDPOINT=

# Optional tracing filter. Defaults to `info`.
RUST_LOG=info

# Optional. Where Abbey persists what she learns (per-guild DQN snapshots,
# reputation, memory facts, the WDBX segment). Unset = in-memory only, lost on
# restart. The directory is created if missing.
ABBEY_DATA_DIR=

# Optional. Set to 1 to request the privileged MESSAGE_CONTENT intent. It must
# ALSO be enabled for the bot in the Developer Portal, or the gateway silently
# sends nothing. Without it Abbey only sees the content of messages that mention
# her or are DMs, and the adaptive loop learns from those alone.
ABBEY_MESSAGE_CONTENT=

# Optional. Image understanding for /see, /ocr, and attachment folding. Any
# OpenAI-compatible vision endpoint; falls back to ABBEY_BOT_LLM_ENDPOINT when
# unset. Blank = vision off.
ABBEY_VISION_ENDPOINT=
ABBEY_VISION_MODEL=
ABBEY_VISION_KEY=

# Optional. Telegram Bot API token — runs the long-poll adapter alongside the
# Discord gateway, feeding the same brain/memory pipeline. Secret: env only.
TELEGRAM_BOT_TOKEN=

# Optional. Slack over Socket Mode: the xoxb- bot token for the Web API and
# the xapp- app-level token for apps.connections.open. Both required; both
# secrets, env only.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
