# Bot token from the Discord Developer Portal. Never commit the real value.
# If it ever leaks, rotate it in the portal immediately — revoking is the fix,
# deleting the commit is not.
DISCORD_TOKEN=

# Optional. Register slash commands to this guild only: instant, which is what
# you want while iterating. Leave unset to register globally, which can take up
# to an hour to propagate.
ABBEY_GUILD_ID=

# Optional. /persona ask's generation backend — first match wins, and with
# neither set the command replies that no generation backend is configured.
#
# Anthropic Messages API (external; costs money per token). This is a secret
# with DISCORD_TOKEN's exact handling: env only, rotate on leak.
ANTHROPIC_API_KEY=

# OpenAI-compatible server, usually loopback (llama-server / ollama / mlx).
# Base URL only, e.g. http://127.0.0.1:8080 — the bot appends
# /v1/chat/completions. Plain HTTP is loopback-only; remote endpoints require
# HTTPS. Credentials, query strings, and fragments are rejected. Servers may
# resolve, validate, or ignore the name depending on their API; always set the
# exact served model for Ollama and MLX-VLM. The cross-platform default name is
# gemma4:12b.
ABBEY_BOT_LLM_ENDPOINT=
ABBEY_BOT_LLM_MODEL=gemma4:12b
# Optional. Concurrent generations (default 1 local / 4 Anthropic) and how long a
# turn waits for a slot before answering "busy" (default 90).
ABBEY_BOT_LLM_CONCURRENCY=
# Optional. `off` stops the model from calling Abbey's tools (remember/recall/
# reputation/persona/recent messages). Default on; degrades itself on a 4xx.
ABBEY_BOT_LLM_TOOLS=
ABBEY_BOT_LLM_QUEUE_SECS=
# Optional. Seconds before a backend call is abandoned (default 300).
ABBEY_BOT_LLM_TIMEOUT_SECS=

# Optional Apple-silicon unified Gemma 4 profile. Install it with
# deploy/install-mlx-vlm-launchd.sh, then use the exact preloaded snapshot path
# for BOTH request model fields; mlx-vlm 0.6.15 treats the model string as its
# cache/load key, so the portable Ollama name `gemma4:12b` is not an alias here.
# ABBEY_BOT_LLM_ENDPOINT=http://127.0.0.1:8282
# ABBEY_BOT_LLM_MODEL=$HOME/.local/share/abbey-bot/mlx-vlm/huggingface/hub/models--mlx-community--gemma-4-12B-it-4bit/snapshots/73bcf09092aa277861d5a191b989b666f7f32e8f
# ABBEY_VISION_ENDPOINT=http://127.0.0.1:8282/v1
# ABBEY_VISION_MODEL=$HOME/.local/share/abbey-bot/mlx-vlm/huggingface/hub/models--mlx-community--gemma-4-12B-it-4bit/snapshots/73bcf09092aa277861d5a191b989b666f7f32e8f
# Apple `fm serve` is a smaller optional text/vision fallback. Use its loopback
# endpoint/model `system` and ABBEY_BOT_LLM_TOOLS=off; its OpenAI facade does
# not currently return tool calls in the wire shape Abbey executes.

# Optional. 1 = never speak unsolicited anywhere; mentions, DMs, and slash
# commands still answer. Keep this on while the policy is untrained on a
# token that sits in many servers.
ABBEY_QUIET=

# Optional tracing filter. Defaults to `info`.
RUST_LOG=info

# Optional. Where Abbey persists what she learns (per-guild DQN snapshots,
# reputation, memory facts, the WDBX segment). Unset = in-memory only, lost on
# restart. The directory is created if missing.
# The macOS launchd installer deliberately ignores this value and always uses
# ~/.local/share/abbey-bot/data so one fixed private directory owns its state.
ABBEY_DATA_DIR=

# Optional. Set to 1 to request the privileged MESSAGE_CONTENT intent. It must
# ALSO be enabled for the bot in the Developer Portal, or the gateway silently
# sends nothing. Without it Abbey only sees the content of messages that mention
# her or are DMs, and the adaptive loop learns from those alone.
ABBEY_MESSAGE_CONTENT=

# Optional. Image understanding for /see, /ocr, and attachment folding. Any
# OpenAI-compatible vision endpoint; remote URLs require HTTPS and loopback may
# use HTTP. Falls back to ABBEY_BOT_LLM_ENDPOINT when unset (set it to `off` to
# stop that fallback for a text-only local model). A reused endpoint inherits
# ABBEY_BOT_LLM_MODEL (then gemma4:12b); a separate remote endpoint defaults to
# gpt-4o-mini. Set ABBEY_VISION_MODEL explicitly for every other server.
# Blank endpoint with no LLM endpoint = vision off.
ABBEY_VISION_ENDPOINT=
ABBEY_VISION_MODEL=
ABBEY_VISION_KEY=

# Optional. Discord voice, locked to exactly one destination. BOTH IDs expose
# `/voice`; local speech is the default and cloud audio is never selected just
# because a key exists. `/voice join consent:true` and `/voice resume
# consent:true` are allowed only after everyone currently present was notified
# and agreed. A membership change pauses capture and playback immediately.
ABBEY_VOICE_GUILD_ID=
ABBEY_VOICE_CHANNEL_ID=
# disabled = presence only; local = loopback STT + Abbey + TTS; openai =
# explicit direct OpenAI Realtime backup. The backup buffers a complete reply
# and does not use local ABI routing or WDBX context. Defaults to local when
# both IDs are set.
ABBEY_VOICE_MODE=local
# Persistent muted/self-deafened startup presence. This path always constructs
# Songbird in DecodeMode::Pass and never installs a receive or playback actor,
# even when a conversational backend is configured.
ABBEY_VOICE_AUTOJOIN=0
# Loopback MLX-Audio OpenAI-compatible server. The local text backend used for
# Abbey reasoning must also be loopback. Defaults shown here match the tested
# Apple-silicon setup; the first consented join preloads both speech models.
ABBEY_VOICE_LOCAL_ENDPOINT=http://127.0.0.1:8181
ABBEY_VOICE_LOCAL_STT_MODEL=mlx-community/whisper-large-v3-turbo-asr-fp16
ABBEY_VOICE_LOCAL_TTS_MODEL=mlx-community/Kokoro-82M-bf16
ABBEY_VOICE_LOCAL_TTS_VOICE=af_heart
ABBEY_VOICE_LOCAL_LANGUAGE=en
ABBEY_VOICE_WAKE_WORD_REQUIRED=1
# Used only when ABBEY_VOICE_MODE=openai. Secret: env only. Setting it alone
# never opts voice in and never overrides local mode.
OPENAI_API_KEY=
# Current official server-to-server default; override deliberately when a new
# Realtime model/voice is selected. Remote endpoints must use wss; loopback may
# use ws for a test double.
ABBEY_VOICE_REALTIME_ENDPOINT=wss://api.openai.com/v1/realtime
ABBEY_VOICE_REALTIME_MODEL=gpt-realtime-2.1
ABBEY_VOICE_NAME=marin
# Optional one-line persona/instructions override. The built-in Abbey voice
# prompt is used when blank. A non-removable control-safety suffix is always
# appended: spoken backup-mode prose cannot claim or perform voice state
# changes and must direct authoritative stops to /voice leave or voice-chat
# text.
ABBEY_VOICE_INSTRUCTIONS=

# Optional. Telegram Bot API token — runs the long-poll adapter alongside the
# Discord gateway, feeding the same brain/memory pipeline. Secret: env only.
TELEGRAM_BOT_TOKEN=

# Optional. Slack over Socket Mode: the xoxb- bot token for the Web API and
# the xapp- app-level token for apps.connections.open. Both required; both
# secrets, env only.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
