# abbey-bot-zig environment contract (phase 1). Never commit a filled copy.
# Every uncommented key below is read by `abbey-bot-zig serve`; the gate
# (tools/check_managed_service.py) fails if one is not.

# Discord bot token. DISCORD_TOKEN wins; DISCORD_BOT_TOKEN is consulted only
# when DISCORD_TOKEN is absent. A present-but-blank DISCORD_TOKEN is an error
# and never falls through. Use a TEST-GUILD bot, never the production token.
DISCORD_TOKEN=
DISCORD_BOT_TOKEN=

# Required to run while the managed Rust bot (com.donaldfilimon.abbey-bot) is
# loaded: set to 1 only for a separate test-guild bot token.
ABBEY_BOT_ZIG_TEST_GUILD=

# Guild for instant command registration (global otherwise).
ABBEY_GUILD_ID=

# Durable memory directory (JSONL store + WDBX segment). Unset: memory only.
ABBEY_DATA_DIR=

# 1 requests the privileged MESSAGE_CONTENT intent (portal toggle required).
ABBEY_MESSAGE_CONTENT=

# Primary generation: a LOOPBACK OpenAI-compatible server (Ollama, mlx-lm).
ABBEY_BOT_LLM_ENDPOINT=
ABBEY_BOT_LLM_MODEL=gemma4:12b

# Rewrite addition: optional fallback OpenAI-compatible endpoint, tried only
# after a primary transport/HTTP failure. Remote hosts must use HTTPS.
ABBEY_BOT_LLM_FALLBACK_ENDPOINT=
ABBEY_BOT_LLM_FALLBACK_MODEL=
ABBEY_BOT_LLM_FALLBACK_KEY=

# Absolute path to the owner-only episode-gate JSON (see the oracle's
# .env.example for the manifest shape). Unset: /remember and /forget write
# locally without the abi gate.
ABBEY_EPISODE_GATE_CONFIG=

# Not read in phase 1 (oracle keys with no Zig consumer yet): voice, music,
# vision, Foundation Models, provider discovery, Telegram, Slack, tools,
# ANTHROPIC_API_KEY, OPENAI_API_KEY, RUST_LOG. See docs/claims.md.
