<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.donaldfilimon.abbey-audio-tap</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/libexec/abbey-bot/audio-tap/abbey-audio-tap</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/.local/share/abbey-bot/audio-tap</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/abbey-bot/audio-tap/service.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/abbey-bot/audio-tap/service.log</string>
</dict>
</plist>
