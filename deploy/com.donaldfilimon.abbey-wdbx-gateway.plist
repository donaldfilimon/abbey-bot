<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.donaldfilimon.abbey-wdbx-gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/libexec/abbey-bot/abi-wdbx-gateway" --grpc 127.0.0.1:50051 --events 127.0.0.1:50052 --store "$HOME/.local/share/abbey-bot/wdbx-gateway" --token-file "$HOME/.config/abbey-bot/episode-gateway-token" --episode-policy "$HOME/.config/abbey-bot/episode-policy.json"</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/.local/share/abbey-bot/wdbx-gateway</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/abbey-bot/wdbx-gateway.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/abbey-bot/wdbx-gateway.log</string>
</dict>
</plist>
